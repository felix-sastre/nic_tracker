<div class="max-w-6xl mx-auto px-4 py-10 font-sans">
  
  <!-- Header & Search -->
  <header class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 mb-2">Nic.ar Domains</h1>
      <p class="text-slate-500">Extracting and monitoring daily registrations.</p>
    </div>

    <form action="<%= root_path %>" method="GET" class="flex gap-2">
      <div class="relative">
        <input type="text" name="fecha" placeholder="DD-MM-YYYY" value="<%= @input_date %>"
               class="pl-4 pr-10 py-2.5 bg-white border border-slate-200 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
          📅
        </div>
      </div>
      <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-all">
        Buscar
      </button>
    </form>
  </header>

  <!-- Error Handling -->
  <% if @error %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-8 rounded-r-xl">
      <p class="text-red-700 font-medium"><%= @error %></p>
    </div>
  <% end %>

  <% if @domains.empty? && !@error %>
    <div class="bg-white rounded-2xl border border-slate-200 border-dashed p-12 text-center">
      <p class="text-slate-500 text-lg">No records found for this date.</p>
    </div>
  <% else %>
    
    <!-- Cool Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
      <% @domains.each do |domain| %>
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-lg transition-all group flex flex-col justify-between h-full relative overflow-hidden">
          
          <!-- Subtle top color bar depending on status -->
          <% if domain.domain_status&.is_online %>
            <div class="absolute top-0 left-0 w-full h-1 bg-green-400"></div>
          <% else %>
            <div class="absolute top-0 left-0 w-full h-1 bg-slate-200"></div>
          <% end %>

          <div>
            <div class="flex justify-between items-start mb-4">
              <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                <%= domain.transaction_type %>
              </span>
              
              <!-- DNS Status Badge -->
              <% if domain.domain_status&.is_online %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span> Online
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-500 ring-1 ring-inset ring-slate-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Offline
                </span>
              <% end %>
            </div>

            <h2 class="text-xl font-bold text-slate-900 tracking-tight truncate" title="<%= domain.name %>.<%= domain.zone %>">
              <%= domain.name %>.<span class="text-slate-400"><%= domain.zone %></span>
            </h2>
            <p class="text-sm text-slate-500 mt-1">ID: <%= domain.nic_id %></p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs text-slate-400 font-medium">
              Checked: <%= domain.domain_status&.checked_at&.strftime("%H:%M") || 'Just now' %>
            </span>
            <a href="http://<%= domain.name %>.<%= domain.zone %>" target="_blank" class="text-sm font-semibold text-indigo-600 group-hover:text-indigo-800 flex items-center gap-1">
              Visit ↗
            </a>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @total_pages.to_i > 1 %>
      <div class="flex items-center justify-between bg-white px-4 py-3 sm:px-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
          <div>
            <p class="text-sm text-slate-700">
              Showing page <span class="font-medium"><%= @current_page %></span> of <span class="font-medium"><%= @total_pages %></span>
              (<span class="font-medium"><%= @total_records %></span> total domains)
            </p>
          </div>
          <div>
            <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
              <% if @current_page > 1 %>
                <a href="<%= root_path(fecha: @input_date, page: @current_page - 1) %>" class="relative inline-flex items-center rounded-l-md px-4 py-2 text-sm font-semibold text-slate-900 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 focus:z-20 focus:outline-offset-0">
                  Previo
                </a>
              <% end %>
              
              <% if @current_page < @total_pages %>
                <a href="<%= root_path(fecha: @input_date, page: @current_page + 1) %>" class="relative inline-flex items-center rounded-r-md px-4 py-2 text-sm font-semibold text-slate-900 ring-1 ring-inset ring-slate-300 hover:bg-slate-50 focus:z-20 focus:outline-offset-0">
                  Siguiente
                </a>
              <% end %>
            </nav>
          </div>
        </div>
      </div>
    <% end %>

  <% end %>
</div>