<div id="<%= dom_id domain %>">
  <div>
    <strong>Nombre:</strong>
    <%= domain.name %>
  </div>

  <div>
    <strong>Zona:</strong>
    <%= domain.zone %>
  </div>

  <div>
    <strong>Fecha de registro:</strong>
    <%= domain.registration_date %>
