<div id="<%= dom_id domain %>">
  <div>
    <strong>Name:</strong>
    <%= domain.name %>
  </div>

  <div>
    <strong>Zone:</strong>
    <%= domain.zone %>
  </div>

  <div>
    <strong>Registration date:</strong>
    <%= domain.registration_date %>
  </div>

  <div>
    <strong>Nic:</strong>
    <%= domain.nic_id %>
  </div>

  <div>
    <strong>Transaction type:</strong>
    <%= domain.transaction_type %>
  </div>

</div>
